# QFTE V13 — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs

# FastAPI
APP_ENV=development
LOG_LEVEL=INFO

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Base de données
DATABASE_URL=sqlite+aiosqlite:///data/qfte.db

# Trading
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
TIMEFRAMES=1m,5m,15m,1h,4h
